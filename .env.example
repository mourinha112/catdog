# Copie para .env e preencha com os dados do Supabase do cliente.
# Na Vercel, cadastre as mesmas variaveis em Settings > Environment Variables.

# --- usado pelo navegador (envio das fotos para o Storage) ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# --- usado pela API (as funcoes em /api) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Segredo que assina o login do painel. Gere um valor longo e aleatorio,
# por exemplo com:  openssl rand -hex 32
AUTH_SECRET=troque-por-um-valor-longo-e-aleatorio

# Opcional, mas recomendado: com a service_role a API ignora o RLS e voce
# pode fechar as policies publicas do banco.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
